# SecureBank Backend Configuration
# Copy this file to .env and adjust values as needed.
# In production, set these as real environment variables.

# Server port (default: 8080)
# SERVER_PORT=8080

# SQLite database path (relative to backend/ directory)
# DATABASE_PATH=../database/securebank.db

# Python executable (used for anomaly detection)
# PYTHON_EXECUTABLE=python

# Allowed frontend origin for CORS
# FRONTEND_URL=http://localhost:5173

# JWT signing secret — CHANGE THIS in any non-demo environment
# JWT_SECRET=your-secret-key-here
